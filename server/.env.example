# ──────────────────────────────────────────────────────────────
# AI-LifeHub — backend environment
# Copy this file to `server/.env` (or `server/env.local`) and fill in real values.
# NEVER commit real secrets.
# ──────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
# Render injects PORT automatically; HOST=0.0.0.0 makes the app reachable.
PORT=4000
HOST=0.0.0.0
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: extra allowed origin(s) for Vercel deployments.
VERCEL_PROJECT_URL=
VERCEL_PREVIEW_PATTERN=

# PostgreSQL (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5432/ai_lifehub?schema=public"
# Neon: DIRECT_URL is the unpooled connection string (drop "-pooler" from the
# host). It is used only by `prisma migrate deploy`. Leave empty locally so
# Prisma falls back to DATABASE_URL.
DIRECT_URL=
# Prisma pool size per instance (keep small on managed Postgres).
PRISMA_CONNECTION_LIMIT=5

# Auth - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_random_64_char_hex_string
JWT_REFRESH_SECRET=replace_with_a_different_random_64_char_hex_string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Cookies: true in production (HTTPS only)
COOKIE_SECURE=false
COOKIE_DOMAIN=

# AI provider: gemini | openai | none
# "none" keeps every AI surface visible but explicitly reports that it is
# unconfigured - the app never fabricates AI output.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# AI guardrails
# Comma-separated fallback chain tried when the configured model is retired
# (Google returns 404) or temporarily overloaded (503). The first model that
# answers is cached for the life of the process.
AI_MODEL_FALLBACKS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-flash-latest,gemini-2.5-flash
# Gemini 3.x "thinking" level: MINIMAL | LOW | OFF (lower = faster replies)
AI_THINKING_LEVEL=MINIMAL
AI_MAX_CONTEXT_TOKENS=12000
AI_CHAT_DAILY_LIMIT=80
AI_INSIGHT_DAILY_LIMIT=30
AI_REQUEST_TIMEOUT_MS=45000
AI_TEMPERATURE=0.4

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
AUTH_RATE_LIMIT_MAX=100

# Demo data
ALLOW_DEMO_DATA=true

# ── Seed script overrides (optional) ─────────────────────────
SEED_EMAIL=demo@ai-lifehub.dev
SEED_PASSWORD=DemoPass123
SEED_NAME=Demo User
SEED_TIMEZONE=Asia/Kolkata
