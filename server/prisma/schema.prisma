// AI-LifeHub — Prisma schema
// PostgreSQL, normalized, strict user-level isolation (every user-owned table
// carries a userId FK with onDelete: Cascade).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled Neon connection string for the application (PgBouncer, transaction mode).
  url       = env("DATABASE_URL")
  // Direct/unpooled connection used by Prisma Migrate. Neon requires this
  // because PgBouncer (transaction mode) cannot run DDL. Leave it unset locally
  // (Prisma then falls back to DATABASE_URL) and set it on Render.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// Identity & auth
// ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  // Null for accounts created through Google (or any future OAuth provider):
  // such users authenticate with the provider, never with a local password.
  // An existing password account keeps its hash when a Google identity is
  // linked to it, so both sign-in methods keep working.
  passwordHash  String?
  name          String
  emailVerified Boolean   @default(false)
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  deletedAt     DateTime?

  profile         Profile?
  settings        UserSettings?
  occupationLabel OccupationLabel?
  sessions        Session[]
  refreshTokens   RefreshToken[]
  passwordResets  PasswordResetToken[]
  oauthAccounts   OAuthAccount[]

  tasks           Task[]
  habits          Habit[]
  habitLogs       HabitLog[]
  moodLogs        MoodLog[]
  journalEntries  JournalEntry[]
  workSessions    WorkSession[]
  dailyActivities DailyActivity[]
  insights        AIInsight[]
  conversations   Conversation[]
  messages        Message[]
  usage           UserUsage[]
  auditLogs       AuditLog[]
  projects        Project[]
  goals           Goal[]
  skills          Skill[]
  skillUpdates    SkillUpdate[]
  skillEvidence   SkillEvidence[]
  developmentPlans DevelopmentPlan[]

  @@index([createdAt])
}

model Profile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  occupation     String? // Free-text label the user chose, kept verbatim
  // Typed counterpart, backfilled from `occupation` by the migration and set
  // by onboarding. Null only for rows created before this migration that the
  // backfill could not classify.
  occupationType OccupationType?
  primaryGoal    String? // Productivity / Consistency / Wellbeing / Learning / Focus
  timezone       String          @default("Asia/Kolkata")
  weekStart      Int             @default(1) // 1 = Monday
  focusHours     String[]        @default([]) // e.g. ["morning"]
  onboarded      Boolean         @default(false)
  onboardingStep Int             @default(0)
  avatarUrl      String?
  bio            String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// A user's own name for their occupation, used when they pick Other / Custom.
// Separate from Profile.occupation so the typed enum and the typed-out words
// can never overwrite each other.
model OccupationLabel {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String // "Medical student", "Farmer", whatever they typed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// OAuth identities (Google)
// ─────────────────────────────────────────────────────────────
// One row per external identity. The provider's stable subject id (never the
// email, which a user can change) is the key, so a Google email change does not
// create a duplicate account. `@@unique([provider, providerAccountId])` makes
// "one Google identity → one local user" a database guarantee.
model OAuthAccount {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider          String    @default("google")
  providerAccountId String // Google 'sub' claim — stable for the life of the account
  email             String // as last reported by the provider
  emailVerified     Boolean   @default(false)
  name              String?
  avatarUrl         String?
  // Granted scopes, space separated (audit / debugging only).
  scope             String?
  linkedAt          DateTime  @default(now())
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model UserSettings {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  theme              String   @default("system") // light | dark | system
  accent             String   @default("violet")
  aiEnabled          Boolean  @default(true)
  aiAutoInsights     Boolean  @default(true) // generate daily insight automatically
  weeklyEmailDigest  Boolean  @default(false)
  moodTrackingOptIn  Boolean  @default(true)
  journalPrivacyNote Boolean  @default(true)
  demoDataLoaded     Boolean  @default(false)

  // Phase 3: the dashboard's own layout. Kept as a JSON string rather than a
  // table because it is one opaque value per user that nothing queries into.
  // Null means "use the occupation's default order".
  dashboardLayout    String?  @db.VarChar(2000)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  expiresAt  DateTime

  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?  @db.Uuid
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Only a SHA-256 hash of the token is stored — a DB leak cannot be replayed.
  tokenHash  String    @unique
  family     String    @db.Uuid // rotation family: reuse detection revokes the family
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?   @db.Uuid
  createdAt  DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([family])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Productivity data
// ─────────────────────────────────────────────────────────────

// How the person spends their day. This is what personalises terminology,
// task categories, dashboard widgets and AI prompts. `Profile.occupation`
// stays as the free-text display label ("Medical student", "iOS engineer")
// so nothing existing breaks and nobody's words are overwritten.
enum OccupationType {
  STUDENT
  WORKING_PROFESSIONAL
  FREELANCER
  BUSINESS_OWNER
  ENTREPRENEUR
  JOB_SEEKER
  TEACHER
  OTHER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

model Task {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?
  category    String       @default("General")
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)

  dueDate      DateTime?
  startedAt    DateTime? // set automatically when moved to IN_PROGRESS
  completedAt  DateTime? // set automatically when moved to COMPLETED
  timeTakenSec Int? // derived automatically: completedAt - startedAt (or createdAt)

  // Containers and hierarchy. All nullable, so every existing task keeps
  // working and simply belongs to nothing.
  projectId String?   @db.Uuid
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parentId  String?   @db.Uuid
  parent    Task?     @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks  Task[]    @relation("TaskSubtasks")
  goalId    String?   @db.Uuid
  goal      Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)

  // Recurrence. The next instance is created when this one is completed, in
  // the same transaction -- there is no scheduler on the host, so a rule that
  // needed one would silently stop repeating.
  recurrence       RecurrenceRule @default(NONE)
  recurrenceEvery  Int            @default(1) // every N days/weeks/months
  recurrenceUntil  DateTime?
  recurrenceSource String?        @db.Uuid // the task this one was spawned from

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, completedAt])
  @@index([userId, priority, status])
  @@index([userId, projectId])
  @@index([parentId])
  @@index([userId, goalId])
}

enum RecurrenceRule {
  NONE
  DAILY
  WEEKDAYS
  WEEKLY
  MONTHLY
}

enum ProjectKind {
  STUDY // a subject or course
  WORK // a work project or initiative
  CLIENT // client work for a freelancer
  BUSINESS // a business initiative
  JOB_SEARCH // an application track
  PERSONAL
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
}

/// One container for subjects, work projects, client engagements, business
/// initiatives and job applications. They differ in vocabulary, not shape --
/// the words come from OCCUPATION_PROFILES, the columns are shared.
model Project {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?
  kind        ProjectKind   @default(WORK)
  status      ProjectStatus @default(PLANNING)
  priority    TaskPriority  @default(MEDIUM)
  /// A subject code ("CS101") or a client name. Optional.
  code        String?
  color       String?

  deadline   DateTime?
  archivedAt DateTime?
  completedAt DateTime?

  tasks      Task[]
  sessions   WorkSession[]
  goals      Goal[]

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, archivedAt])
  @@index([userId, kind])
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  PAUSED
  ABANDONED
}

model Goal {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?
  status      GoalStatus @default(ACTIVE)
  /// What the number means ("chapters", "interviews"). Free text so a goal
  /// is not forced into a unit the user does not think in.
  metric      String?
  target      Float?
  current     Float? // maintained by the user; never inferred
  deadline    DateTime?
  achievedAt  DateTime?

  projectId String?  @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Phase 5: a goal may be the record of a skill being developed. Nullable, so
  // every goal that existed before growth planning keeps working untouched.
  skillId String? @db.Uuid
  skill   Skill?  @relation(fields: [skillId], references: [id], onDelete: SetNull)

  tasks      Task[]
  milestones Milestone[]

  // The plan item that produced this goal, if any. SetNull on delete: a goal
  // outlives the plan it came from, it does not disappear with it.
  planItems DevelopmentPlanItem[]
  // A goal can be the goal of a development plan.
  plans DevelopmentPlan[]

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, projectId])
}

model Milestone {
  id     String @id @default(uuid()) @db.Uuid
  goalId String @db.Uuid
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  // Denormalised so isolation checks never need a join.
  userId String @db.Uuid

  title       String
  dueDate     DateTime?
  completedAt DateTime?
  order       Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([goalId])
  @@index([userId])
}

enum HabitFrequency {
  DAILY
  WEEKLY
}

model Habit {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  description   String?
  icon          String         @default("Sparkles")
  color         String         @default("violet")
  frequency     HabitFrequency @default(DAILY)
  targetPerWeek Int            @default(7) // used for WEEKLY habits (and goal framing for DAILY)
  active        Boolean        @default(true)
  isDemo        Boolean        @default(false)
  archivedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  logs HabitLog[]

  @@unique([userId, name])
  @@index([userId, active])
}

model HabitLog {
  id      String @id @default(uuid()) @db.Uuid
  habitId String @db.Uuid
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId  String @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Calendar day (UTC-normalized "date key") — one check-in per habit per day.
  date      DateTime @db.Date
  note      String?
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([userId, date])
}

enum MoodLevel {
  GREAT
  GOOD
  NEUTRAL
  BAD
  TERRIBLE
}

model MoodLog {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  level     MoodLevel
  score     Int // 5=great … 1=terrible, denormalized for fast aggregation
  note      String?
  energy    Int? // 1-5 optional
  focus     Int? // 1-5 optional
  date      DateTime  @db.Date
  isDemo    Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model JournalEntry {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String?
  content   String
  date      DateTime @db.Date
  wordCount Int      @default(0)

  // AI enrichment (nullable — only present once analyzed)
  sentiment         String? // positive | neutral | negative | mixed
  sentimentScore    Float? // -1 … 1
  summary           String?
  themes            String[]  @default([])
  productivityNotes String?
  analyzedAt        DateTime?
  isDemo            Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId, date])
}

enum SessionCategory {
  STUDYING
  CODING
  OFFICE_WORK
  READING
  PERSONAL_PROJECTS
  OTHER
}

model WorkSession {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  category    SessionCategory @default(STUDYING)
  label       String?
  startedAt   DateTime
  endedAt     DateTime?
  pausedAt    DateTime?
  // accumulated paused milliseconds, so duration excludes pauses
  pausedMs    Int             @default(0)
  durationSec Int             @default(0) // recalculated on stop
  status      String          @default("RUNNING") // RUNNING | PAUSED | COMPLETED
  focusScore  Int? // self reported 1-5 at stop (optional)
  notes       String?
  date        DateTime        @db.Date
  projectId   String?         @db.Uuid
  project     Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  breaks      SessionBreak[]
  isDemo      Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId, date])
  @@index([userId, status])
  @@index([userId, projectId])
}

/// One row per pause. `pausedMs` on the session stays as the fast total; these
/// rows exist so break length is analysable instead of being one opaque number.
model SessionBreak {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @db.Uuid
  session   WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String      @db.Uuid

  startedAt DateTime
  endedAt   DateTime?
  seconds   Int? // filled when the break ends

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([userId])
}

// One row per calendar day — the denormalized "life log" that the AI pipeline
// and analytics read from. Fields are nullable because everything is optional.
model DailyActivity {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date              DateTime @db.Date
  sleepMinutes      Int?
  exerciseMinutes   Int?
  screenMinutes     Int?
  meditationMinutes Int?
  socialMinutes     Int?
  steps             Int?

  // Self-reported 1-5, the same scale MoodLog uses for energy and focus, so the
  // two can be compared without rescaling. Optional: a person may log sleep and
  // nothing else, and a null here means "not reported", never "zero".
  stressLevel       Int? // 1 = calm, 5 = overwhelmed
  energyLevel       Int? // 1 = drained, 5 = full of energy
  sleepQuality      Int? // 1 = restless, 5 = deeply rested

  source            String   @default("manual") // manual | csv | device
  notes             String?
  isDemo            Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

// ─────────────────────────────────────────────────────────────
// AI
// ─────────────────────────────────────────────────────────────

enum InsightType {
  PRODUCTIVITY
  HABIT
  OVERLOAD
  MOOD
  JOURNAL
  WEEKLY_SUMMARY
  ROUTINE
  FOCUS
  GOALS
  GROWTH
}

model AIInsight {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type            InsightType
  title           String
  body            String // markdown, 1-3 short paragraphs
  recommendations String[]    @default([])
  confidence      String      @default("low") // low | medium | high — driven by data volume
  dataPoints      Json? // the feature snapshot that produced it (audit trail)
  provider        String // gemini | openai | none
  model           String?
  periodStart     DateTime?
  periodEnd       DateTime?
  dismissed       Boolean     @default(false)
  pinned          Boolean     @default(false)
  isDemo          Boolean     @default(false)
  createdAt       DateTime    @default(now())

  @@index([userId, type, createdAt])
  @@index([userId, dismissed])
}

model Conversation {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String   @default("New conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  role      String // user | assistant | system
  content   String
  tokensIn  Int?
  tokensOut Int?
  provider  String?
  model     String?
  error     String?
  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([userId])
}

// Per-user-per-day AI usage metering (rate limiting + cost visibility).
model UserUsage {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date            DateTime @db.Date
  chatMessages    Int      @default(0)
  insights        Int      @default(0)
  journalAnalyses Int      @default(0)
  tokensIn        Int      @default(0)
  tokensOut       Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@unique([userId, date])
}

// ─────────────────────────────────────────────────────────────
// Phase 5: skills, evidence and development plans
// ─────────────────────────────────────────────────────────────

enum SkillCategory {
  TECHNICAL
  COMMUNICATION
  LEADERSHIP
  BUSINESS
  ACADEMIC
  CREATIVE
  PERSONAL
  OTHER
}

/// Ordered, not scored. A level is a word the user picked; the numeric `rank`
/// exists only so the UI can sort and compare, never to invent a percentage.
enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum SkillStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

model Skill {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  category    SkillCategory @default(OTHER)
  description String?

  /// Where the person is now, and where they want to be. Never inferred:
  /// both are set by the user, and every change writes a SkillUpdate row.
  currentLevel SkillLevel @default(BEGINNER)
  targetLevel  SkillLevel?

  status SkillStatus @default(ACTIVE)
  /// Why this skill matters to them, in their words.
  motivation String?

  startedAt   DateTime @default(now())
  achievedAt  DateTime?
  archivedAt  DateTime?

  updates   SkillUpdate[]
  evidence  SkillEvidence[]
  goals     Goal[]
  planItems DevelopmentPlanItem[]

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, status])
  @@index([userId, category])
}

/// One row per recorded level change. This is what makes "improved" a fact
/// rather than a guess: without a row here, nothing claims a change happened.
model SkillUpdate {
  id      String @id @default(uuid()) @db.Uuid
  skillId String @db.Uuid
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  userId  String @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fromLevel SkillLevel?
  toLevel   SkillLevel
  note      String?
  /// Minutes the user recorded practising for this change, if they recorded any.
  minutes   Int?
  createdAt DateTime  @default(now())

  @@index([skillId, createdAt])
  @@index([userId, createdAt])
}

enum EvidenceKind {
  PRACTICE
  PROJECT
  COURSE
  CERTIFICATE
  FEEDBACK
  PORTFOLIO
  NOTE
}

/// Evidence the user attached to a skill. Free text and a link; the app never
/// reads the link, it only stores what the person says it is.
model SkillEvidence {
  id      String @id @default(uuid()) @db.Uuid
  skillId String @db.Uuid
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  userId  String @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind  EvidenceKind @default(NOTE)
  title String
  detail String?
  url    String?
  date   DateTime?
  createdAt DateTime @default(now())

  @@index([skillId])
  @@index([userId])
}

enum PlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

/// A development plan: the AI's recommendation, kept as a record so it can be
/// measured later. Its items point at real Goal / Milestone / Task rows --
/// the plan never becomes a second task system.
model DevelopmentPlan {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  summary  String?
  /// Where the plan came from. AI plans are recommendations and are labelled
  /// as such everywhere they are shown.
  source   String  @default("AI")
  status   PlanStatus @default(DRAFT)

  horizonWeeks Int @default(4)
  weeklyMinutes Int?
  /// The measured evidence the model was given, kept for audit.
  inputs Json?

  goalId String? @db.Uuid
  goal   Goal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)

  items DevelopmentPlanItem[]

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

enum PlanItemKind {
  OBJECTIVE
  ACTIVITY
  MILESTONE
  SKILL
}

model DevelopmentPlanItem {
  id     String @id @default(uuid()) @db.Uuid
  planId String @db.Uuid
  plan   DevelopmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId String @db.Uuid

  kind PlanItemKind @default(ACTIVITY)
  title String
  detail String?
  week  Int  @default(1)
  order Int  @default(0)
  /// How the person will know it worked, in the plan's own words.
  successCriteria String?

  skillId String? @db.Uuid
  skill   Skill?  @relation(fields: [skillId], references: [id], onDelete: SetNull)

  /// The real records this item was applied to. Null until the user applies it.
  goalId       String? @db.Uuid
  goal         Goal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)
  milestoneId  String? @db.Uuid
  taskId       String? @db.Uuid
  appliedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([planId, order])
  @@index([userId])
}
