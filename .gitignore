# ─── Dependencies ────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Build output ────────────────────────────────────────────
dist/
build/
dist-ssr/
.test-dist/
.seed-dist/
*.tsbuildinfo
.vite/
coverage/
.vitest/
out/
.turbo/

# ─── Environment & secrets (NEVER commit) ────────────────────
.env
.env.*
!.env.example
env.local
*.pem
*.key
*.p12
*.pfx
*.crt
secrets/
credentials.json
serviceAccount*.json

# ─── Prisma ──────────────────────────────────────────────────
# Generated client is rebuilt by `prisma generate`
server/src/generated/
*.db
*.db-journal
*.sqlite
*.sqlite3

# ─── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Editors & OS ────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ─── Test / tooling caches ───────────────────────────────────
.cache/
.parcel-cache/
.nyc_output/
playwright-report/
test-results/
.qodo/

# ─── Misc ────────────────────────────────────────────────────
tmp/
temp/
*.local
